# Copy to .local/stack.env and fill in. Do not commit stack.env.

# --- Portal ---
PORTAL_URL=https://portal.example.com
PORTAL_API_TOKEN=

# --- Dockhand (redeploy / container ops) ---
DOCKHAND_URL=https://dockhand.example.com
DOCKHAND_API_TOKEN=
# Optional: stack or compose project name the portal lives in
DOCKHAND_PORTAL_STACK=

# --- Notifiarr ---
NOTIFIARR_URL=https://notifiarr.example.com
NOTIFIARR_API_KEY=
# Keep portal Discord webhook empty when Notifiarr owns channel posts
NOTIFIARR_OWNS_DISCORD=true

# --- Request / media ---
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PLEX_URL=
PLEX_TOKEN=

# --- Discord (portal bot / invite only; Notifiarr for media posts) ---
DISCORD_INVITE_URL=https://discord.gg/your-invite
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Leave blank if Notifiarr posts media events
DISCORD_WEBHOOK_URL=

# --- Optional ---
# TAUTULLI_URL=
# TAUTULLI_API_KEY=
# OVERSEERR_URL=
