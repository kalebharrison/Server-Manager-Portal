{
  "name": "server-manager-portal",
  "version": "1.0.0",
  "description": "Self-hosted Plex/Jellyfin management and analytics portal.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./client/styles/input.css -o ./static/tailwind.css",
    "build:js": "rm -rf static/chunks && esbuild client/main.tsx --bundle --outdir=static --entry-names=bundle --chunk-names=chunks/[name]-[hash] --splitting --jsx=automatic --format=esm --define:process.env.NODE_ENV=\\\"production\\\" --minify",
    "build:version": "node scripts/build-version.js && node scripts/build-release-notes.js",
    "build": "npm run build:css && npm run build:js && npm run build:version",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'tests/**/*.test.js'",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run build && npm run typecheck && npm test && npm run audit:prod",
    "start": "npm run build && node --env-file=.env server/index.js",
    "start:prod": "node server/index.js",
    "docker:up": "docker compose -f docker/compose.yml up -d --build",
    "docker:local": "sh scripts/local-container.sh"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.1",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
