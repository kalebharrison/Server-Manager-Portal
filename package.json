{
  "name": "server-manager-portal",
  "version": "1.0.0",
  "description": "A web application to automatically manage Plex user access based on expiry dates.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./static/tailwind.css",
    "build:js": "rm -rf static/chunks && esbuild index.tsx --bundle --outdir=static --entry-names=bundle --chunk-names=chunks/[name]-[hash] --splitting --jsx=automatic --format=esm --define:process.env.NODE_ENV=\\\"production\\\" --minify",
    "build:version": "node build-version.js",
    "build": "npm run build:css && npm run build:js && npm run build:version",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm run typecheck",
    "start": "npm run build && node --env-file=.env index.js",
    "start:prod": "node index.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.21.0",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
