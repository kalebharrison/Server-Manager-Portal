/status-config.json

# Environment secrets
.env
.env.*
!.env.example

# Root-only scratch test scripts (not tests/**/*.test.js)
/test*.js
/test*.cjs

# Build artifacts
patch.cjs
static/bundle.js
static/chunks/
static/tailwind.css
static/release-notes.json

# Local scratch
/unneeded/
/v2/

# Private homelab stack (API keys, Dockhand, Notifiarr, etc.) — never commit secrets
.local/*
!.local/README.md
!.local/*.example
!.local/*.example.*
