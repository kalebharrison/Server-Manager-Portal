# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime data (repo-root only — do not ignore lib/config or tests/config)
/config/
/backup/

# Legacy root-level data files (pre-config/ migration)
/config.json
/users.json
/status.json
/deleted_users.json
/audit.json
/emails.json
/subzero-health.json
